# Firebase Web Client Configuration (Frontend)
FIREBASE_API_KEY="your-api-key-here"
FIREBASE_AUTH_DOMAIN="alpha-squared-iot.firebaseapp.com"
FIREBASE_DATABASE_URL="https://alpha-squared-iot-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="alpha-squared-iot"
FIREBASE_STORAGE_BUCKET="alpha-squared-iot.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Serverless Emergency Email Dispatcher (Backend / Vercel Functions)
# Used only in protected server environment - NEVER expose to client-side JS!
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="caregiver.alerts@gmail.com"
SMTP_PASS="your-app-password"
ALERT_SENDER_EMAIL="ALPHA SQUARED Emergency <noreply.alerts@alphasquared.org>"

# Hardware ESP32 Defaults
ESP32_DEVICE_ID="ESP32-ALPHA-01"
DEFAULT_PATIENT_ID="PATIENT-001"

# Hardware Health Device API Configuration (Protected Backend Serverless Environment)
HARDWARE_API_BASE_URL="https://api.yourdevicecloud.com/v1"
HARDWARE_API_KEY="your-hardware-api-key-here"
HARDWARE_CLIENT_SECRET="your-hardware-client-secret-here"
HARDWARE_DEVICE_MODEL="CUSTOM_HEALTH_DEVICE"
HARDWARE_POLL_INTERVAL_SECONDS="15"

