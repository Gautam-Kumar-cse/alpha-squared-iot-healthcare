# ==============================================================================
# PRIMARY PERSISTENT CLOUD DATABASE — MongoDB Atlas (Required for Production / Vercel)
# ==============================================================================
# Format: mongodb+srv://<username>:<password>@<cluster-name>.<unique-id>.mongodb.net/<database_name>?retryWrites=true&w=majority
# NEVER put real database passwords or secrets in this example file or commit to Git!
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/alpha_squared_iot?retryWrites=true&w=majority"
MONGODB_DB_NAME="alpha_squared_iot"

# ==============================================================================
# HARDWARE ESP32 & DEVICE AUTHENTICATION (Protected Backend Serverless Environment)
# ==============================================================================
HARDWARE_API_KEY="your-secure-hardware-api-key-here"
ESP32_DEVICE_ID="ESP32-ALPHA-01"
DEFAULT_PATIENT_ID="PATIENT-001"

# ==============================================================================
# LEGACY / OPTIONAL: Firebase Realtime Database (RTDB) Configuration
# Retained for backward compatibility. MongoDB Atlas is now the primary database.
# ==============================================================================
FIREBASE_API_KEY="your-api-key-here"
FIREBASE_AUTH_DOMAIN="alpha-squared-iot.firebaseapp.com"
FIREBASE_DATABASE_URL="https://alpha-squared-iot-default-rtdb.firebaseio.com"
FIREBASE_PROJECT_ID="alpha-squared-iot"
FIREBASE_STORAGE_BUCKET="alpha-squared-iot.appspot.com"
FIREBASE_MESSAGING_SENDER_ID="123456789012"
FIREBASE_APP_ID="1:123456789012:web:abcdef123456"
FIREBASE_AUTH_SECRET="your-firebase-database-secret-or-service-token"

# ==============================================================================
# EMERGENCY ALERT DISPATCHER (Protected Server Environment)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="caregiver.alerts@gmail.com"
SMTP_PASS="your-app-password"
ALERT_SENDER_EMAIL="ALPHA SQUARED Emergency <noreply.alerts@alphasquared.org>"

